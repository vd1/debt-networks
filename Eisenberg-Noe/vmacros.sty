\newcommand{\CXXPR}[5]{
\shortstack{
$#4$
\\
\hspace*{#2em}\hrulefill\raisebox{-.2em}{\small $\;#1$}\hspace*{#3em}
\\
$#5$
}
}

\newcommand{\XXPR}[4]{\shortstack{$#3$\\\hspace*{#1em}\hrulefill%
\hspace*{#2em}\\$#4$}}
%%%%%%%%%%% XXPR avec translation de la conclusion (??)
\newcommand{\XXXPR}[4]{\shortstack{$#3$\\\hspace*{#1em}\hrulefill%
\hspace*{#2em}\\
{\count11=#1\count12=#2 
\advance\count11 by-\count12 
\divide\count11 by 2
\hspace*{\count11em}}
$#4$}}
\newcommand{\XPR}[3]{\XXPR{#1}{#1}{#2}{#3}}
\newcommand{\PR}[2]{\XXPR{0}{0}{#1}{#2}} 
\newcommand{\TR}[2]{\shortstack{$#1$\\\vdots\\\mbox{}\\$#2$}}
\newcommand{\LR}[2]{\raisebox{#2ex}{$#1$}}
\newcommand{\CPR}[3]{\PR{#2}{#3}\;\raisebox{1.8em}{{\small\tt#1}}}
\newcommand{\RPR}[3]{\PR{#2}{#3}\;\raisebox{1em}{{\small\tt#1}}}
\newcommand{\KR}[2]{\shortstack{$ #1 $\\ \mbox{} \\ $ #2 $}}
\newcommand{\KKR}[2]{\shortstack{$ #1 $\\ \mbox{} \\\mbox{} \\ $ #2 $}}

