% images

\def\ig#1#2{
\begin{figure}[h!]
   \centering
   \label{#2}
   \includegraphics[width=#1]{#2} 
\end{figure}
}

\def\IG#1#2#3{
\begin{figure}[h!]
   \centering
   \label{#2}
   \includegraphics[width=#1]{#2} 
   \caption{\small\it#3}
\end{figure}
}

\def\IGS#1#2#3{
\begin{figure*}[h!]
   \centering
   \label{#2}
   \includegraphics[width=#1]{#2} 
   \caption{\small\it#3}
\end{figure*}
}

